# ═══════════════════════════════════════════════════════════════════
# CiteSite Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values for local development
# For production, set these as Cloudflare Worker secrets using:
# npx wrangler secret put SECRET_NAME

# ───────────────────────────────────────────────────────────────────
# STRIPE CONFIGURATION (Required for checkout & webhook)
# ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

# Stripe Success/Cancel URLs (optional — defaults to CITESITE_URL)
STRIPE_SUCCESS_URL=https://citesite.net/?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://citesite.net/?checkout=cancel

# ───────────────────────────────────────────────────────────────────
# ANTHROPIC API (for audit analysis)
# ───────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ───────────────────────────────────────────────────────────────────
# SITE CONFIGURATION
# ───────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://citesite.net
CITESITE_URL=https://citesite.net

# ───────────────────────────────────────────────────────────────────
# PRICING CONFIGURATION
# ───────────────────────────────────────────────────────────────────
# CHF amount in cents (4999 = CHF 49.99)
PRICE_CHF_CENTS=4999
PRICE_CURRENCY=chf

# ───────────────────────────────────────────────────────────────────
# ADMIN AUTHENTICATION (for /admin-audit access)
# ───────────────────────────────────────────────────────────────────
# Use a strong, random string — set once, never change
ADMIN_KEY=your-secure-random-key-here

# ───────────────────────────────────────────────────────────────────
# CLOUDFLARE ACCESS (for API authentication)
# ───────────────────────────────────────────────────────────────────
# Both must be set for JWT-based admin auth to work; if either is missing
# the audit-api refuses to validate any Cloudflare Access JWT.
CF_ACCESS_TEAM_DOMAIN=your-team-name
CF_ACCESS_AUD=your-app-aud-tag

# ───────────────────────────────────────────────────────────────────
# EMAIL DELIVERY (used by stripe-webhook to send report links)
# ───────────────────────────────────────────────────────────────────
# Set ONE of these — the webhook prefers SendGrid if both are present.
SENDGRID_API_KEY=SG....
RESEND_API_KEY=re_...

# ───────────────────────────────────────────────────────────────────
# GITHUB OAUTH (used by oauth-proxy)
# ───────────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match auth.citesite.net/callback
GITHUB_CLIENT_ID=Iv1....
GITHUB_CLIENT_SECRET=ghs_...
# Optional — origin allowed to receive postMessage from /callback.
# Defaults to https://citesite.net.
OAUTH_OPENER_ORIGIN=https://citesite.net

# ───────────────────────────────────────────────────────────────────
# CORS (optional — comma-separated allowlist for checkout + audit-api)
# ───────────────────────────────────────────────────────────────────
# If unset, both workers fall back to a built-in list of citesite.net
# origins plus localhost:5173/5174 for dev.
ALLOWED_ORIGINS=https://citesite.net,https://www.citesite.net

# ───────────────────────────────────────────────────────────────────
# DATABASE (D1 — handled by wrangler.toml, not env vars)
# ───────────────────────────────────────────────────────────────────
# D1 binding name: DB
# Database name: citesite-db
# ID: c3773f9a-5b71-4095-9b48-2131eea61eaf
