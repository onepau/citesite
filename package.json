{
  "name": "citesite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:audit-api": "cd workers/audit-api && wrangler publish && cd ../..",
    "deploy:checkout": "cd workers/checkout && wrangler publish && cd ../..",
    "deploy:webhook": "cd workers/stripe-webhook && wrangler publish && cd ../..",
    "deploy:oauth": "cd workers/oauth-proxy && wrangler publish && cd ../..",
    "deploy:workers": "npm run deploy:audit-api && npm run deploy:checkout && npm run deploy:webhook && npm run deploy:oauth",
    "deploy:frontend": "npm run build && npx wrangler pages publish dist --project-name citesite",
    "db:init": "npx wrangler d1 execute citesite-db --file workers/db/orders.sql",
    "db:verify": "npx wrangler d1 execute citesite-db --command \"SELECT name FROM sqlite_master WHERE type='table';\"",
    "secrets:list": "npx wrangler secret list",
    "setup": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0"
  }
}
